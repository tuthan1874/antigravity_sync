# Workforce App — Quản lý Freelancer & Nghiệm thu

App mới trong hệ sinh thái TD Games Platform, quản lý nhân sự freelancer/inhouse, đồng bộ task từ ClickUp, nghiệm thu tháng, và theo dõi chi phí theo project/client.

## User Review Required

> [!IMPORTANT]
> **ClickUp API Token**: App cần ClickUp API token. Bạn có muốn mỗi user tự nhập token hay dùng 1 token chung (admin config)?

> [!IMPORTANT]
> **ClickUp Space/List**: Bạn muốn sync từ Space/List nào? Cần cung cấp Space ID và List ID(s) cần sync.

> [!WARNING]
> **Scope lớn** — Plan chia thành **3 phase** để ship từng phần. Phase 1 (cơ bản) có thể dùng được ngay, không cần chờ ClickUp integration.

---

## Database Schema (Supabase — cùng project `fifuhkupaqcfjwyouwpa`)

```sql
-- Nhân sự (freelancer / inhouse)
CREATE TABLE wf_workers (
  id         uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  full_name  text NOT NULL,
  email      text,
  phone      text,
  type       text NOT NULL DEFAULT 'freelancer'  -- freelancer | inhouse
               CHECK (type IN ('freelancer','inhouse')),
  bank_name  text DEFAULT '',
  bank_account text DEFAULT '',
  tax_code   text DEFAULT '',
  notes      text DEFAULT '',
  is_active  boolean DEFAULT true,
  created_at timestamptz DEFAULT now()
);

-- Hợp đồng
CREATE TABLE wf_contracts (
  id          uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  worker_id   uuid NOT NULL REFERENCES wf_workers(id) ON DELETE CASCADE,
  title       text NOT NULL,                      -- "HĐ tháng 3/2026"
  start_date  date NOT NULL,
  end_date    date,
  rate_type   text DEFAULT 'per_task'             -- per_task | monthly | hourly
                CHECK (rate_type IN ('per_task','monthly','hourly')),
  rate_amount numeric DEFAULT 0,                  -- mức giá mặc định
  currency    text DEFAULT 'VND',
  status      text DEFAULT 'active'               -- active | completed | terminated
                CHECK (status IN ('active','completed','terminated')),
  notes       text DEFAULT '',
  created_at  timestamptz DEFAULT now()
);

-- Task (sync từ ClickUp hoặc nhập tay)
CREATE TABLE wf_tasks (
  id             uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  worker_id      uuid REFERENCES wf_workers(id),
  project        text DEFAULT '',                 -- tên project
  client_name    text DEFAULT '',                 -- tên khách hàng
  title          text NOT NULL,
  clickup_task_id text,                           -- ID task trên ClickUp (nullable)
  clickup_list_id text,
  clickup_status  text,                           -- status trên ClickUp
  status         text DEFAULT 'in_progress'       -- in_progress | completed | approved | rejected
                   CHECK (status IN ('in_progress','completed','approved','rejected')),
  price          numeric DEFAULT 0,               -- giá task này
  currency       text DEFAULT 'VND',
  completed_at   date,
  approved_at    date,
  notes          text DEFAULT '',
  synced_at      timestamptz,                     -- lần sync gần nhất
  created_at     timestamptz DEFAULT now(),
  updated_at     timestamptz DEFAULT now()
);

-- Nghiệm thu tháng
CREATE TABLE wf_settlements (
  id           uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  worker_id    uuid NOT NULL REFERENCES wf_workers(id),
  period       text NOT NULL,                     -- "2026-03" (YYYY-MM)
  total_tasks  integer DEFAULT 0,
  total_amount numeric DEFAULT 0,
  currency     text DEFAULT 'VND',
  status       text DEFAULT 'draft'               -- draft | sent | accepted | paid
                 CHECK (status IN ('draft','sent','accepted','paid')),
  expense_id   uuid,                              -- link → expense_expenses (auto-created)
  notes        text DEFAULT '',
  created_at   timestamptz DEFAULT now()
);

-- Settlement ↔ Task (nhiều task → 1 settlement)
CREATE TABLE wf_settlement_tasks (
  id            uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  settlement_id uuid NOT NULL REFERENCES wf_settlements(id) ON DELETE CASCADE,
  task_id       uuid NOT NULL REFERENCES wf_tasks(id),
  UNIQUE(settlement_id, task_id)
);
```

