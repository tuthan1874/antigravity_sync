  if (!currentUser) return <LoginScreen onLogin={setCurrentUser} />;

  // ── App Router ──
  if (activeApp === 'dashboard') {
    return <DashboardApp currentUser={currentUser} onBack={handleBack} initialTab={initialTab} />;
