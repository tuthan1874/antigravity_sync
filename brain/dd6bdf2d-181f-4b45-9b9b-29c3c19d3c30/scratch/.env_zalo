# === Zalo Sales CRM ===
PORT=3000
NODE_ENV=production
APP_URL=https://zalo.tdconsulting.vn

# Security — generate strong random values for production
JWT_SECRET=b6e82bd4871dbcb9c229f3b890a886f443b74558509c13b28b5e40cf7d25e40e
ENCRYPTION_KEY=1f98bc1982b6be070dd42ffc06f370ba62f6b4de9add249911e2f7f329976b92

# Database
DB_USER=crmuser
DB_PASSWORD=SecureDbPassw0rd123!
DB_NAME=zalocrm
DATABASE_URL=postgresql://crmuser:SecureDbPassw0rd123!@db:5432/zalocrm

# Storage
UPLOAD_DIR=/var/lib/zalo-crm/files

# AI — Global defaults
AI_DEFAULT_PROVIDER=anthropic
AI_DEFAULT_MODEL=claude-sonnet-4.6

# AI Provider: Anthropic
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=
